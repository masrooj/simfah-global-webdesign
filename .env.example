# Public site URL (used for sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp click-to-chat — digits only, country code, no +
NEXT_PUBLIC_WHATSAPP_NUMBER=94777154524

# Contact form endpoint (default: same-origin /api/contact — do not point at simfahglobal.com from localhost; CORS will block the form)
# NEXT_PUBLIC_CONTACT_API_URL=/api/contact

# SMTP — same as simfahglobal.com enterprise site (Hostinger)
# Local: copy to .env.local (gitignored). Password starting with $ → SMTP_PASS=\$your_password
# Vercel: Project → Settings → Environment Variables (Production + Preview). Plain password, no backslash.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=connect@simfahglobal.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=connect@simfahglobal.com
SMTP_SECURE=true
SMTP_ENCRYPTION=SSL
